# ---- 本地产物与诊断证据目录 ----
# CI workflow 的 paths-ignore 已把 artifacts/ 视为非源码；该目录同时是以下脚本的
# 产物落地点，不应入库：
#   scripts/verify-windows-bundle.ps1      -> artifacts/windows-preview/
#   scripts/generate-updater-manifest.ps1  -> artifacts/windows-release/
#   Testing/battery-ui-check.cjs           -> artifacts/remote-battery/
artifacts/

# 文档流水线工作目录（一次性生成物）
output/

# TypeScript / Vite 增量构建缓存（vue-tsc）
*.tsbuildinfo

# Python 本地环境（scripts/、Testing/ 下有一批辅助 .py）
.venv/
venv/
.pytest_cache/

# Windows 系统与崩溃产物
Thumbs.db
ehthumbs.db
desktop.ini
*.lnk
*.dmp
*.stackdump

# 补丁 / 合并 / 编辑器残留（本仓库常手工 git apply）
*.orig
*.rej
*.bak
*~
*.swp
*.tmp

# ---- 硬件取证原始输出（不入库） ----
# 2026-11-15 用户决定：真机采集的原始输出含本机用户名、蓝牙地址与会话令牌，
# 且属于一次性的过程物，不再入库。要复现请在本地跑 hardware/RC003/probes/ 下的脚本，
# 输出目录留在本机。上面的 `*.log` 规则已经覆盖，这里再显式锁一层目录。
hardware/RC003/evidence/

# ---- RC003 助手（路线 A）的 vendored 注入载体 ----
# 版本与 SHA-256 由 hardware/RC003/helper/vendor/frida-gadget.lock.json 固定；
# 二进制本身（约 23 MB）不入库，由 vendor/fetch_frida_gadget.py 按锁定值下载并校验。
# 入库的是「可复现的获取方式 + 锁定的完整性凭据」，而不是大文件本身。
hardware/RC003/helper/vendor/*.dll
hardware/RC003/helper/vendor/*.dll.xz
hardware/RC003/helper/vendor/*.part

# 本机开发启动器：硬编码本机 node 位置，不入库（见文件头说明）
/dev-app.cmd

# 本地测试包构建配置（出包脚本按需重新生成），不入库
/src-tauri/tauri.local-test.conf.json

# 打包资源暂存（构建产物，由出包脚本复制）
/src-tauri/resources/

# 出包暂存产物（beforeBundleCommand 复制）
/src-tauri/sayall-helper.exe
/src-tauri/frida-gadget.dll
/src-tauri/sayall-mcp.exe
# arm64 双载荷（2026-10-07 issue206）：同上，只有本机具备 VS ARM64 工具集
# （VC.Tools.ARM64 + rustup 的 aarch64 目标）时才暂存得到，因此不可入库。
# Gadget 的 arm64 源由上面 vendor/*.dll 与 vendor/*.dll.xz 两条规则覆盖。
/src-tauri/sayall-helper-arm64.exe
/src-tauri/frida-gadget-arm64.dll

# 本地出包的临时前端产物（safe-delete 守卫绕法），不入库
dist-build/
dist-build-*/

# 一次性调试探针：只在本地使用，不入库（会用真实解绑/重配，入库有误用风险）
crates/sayall-windows/examples/pair_repair_probe.rs
crates/sayall-windows/examples/gatt_fromid_probe.rs
crates/sayall-windows/examples/gatt_live_read_probe.rs
crates/sayall-windows/examples/gatt_services_matrix_probe.rs
