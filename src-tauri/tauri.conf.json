{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Free Say",
  "version": "1.0.1",
  "identifier": "app.getsayall.freesayall.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:2430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "beforeBundleCommand": "node scripts/stage-bundle-resources.cjs"
  },
  "app": {
    "windows": [
      {
        "title": "Free Say 1.0.0",
        "width": 1066.67,
        "height": 800,
        "minWidth": 1066.67,
        "minHeight": 800,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "guiyko",
    "category": "Productivity",
    "shortDescription": "把 RC001/RC003 遥控器的语音和按键桥接到 Windows",
    "longDescription": "Free Say Windows 版通过公开 Windows API 接收 RC001 和 RC003 遥控器的语音和普通按键。",
    "icon": [
      "icons/app-icons/faceted-duck-256.png",
      "icons/app-icons/faceted-duck.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/app-icons/faceted-duck.ico",
        "installerHooks": "windows/installer-hooks.nsh",
        "uninstallerIcon": "icons/app-icons/faceted-duck.ico",
        "startMenuFolder": "Free Say"
      }
    },
    "resources": [
      "sayall-helper.exe",
      "frida-gadget.dll",
      "sayall-mcp.exe"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyRUY0RDUwOEQ1ODAyNDgKUldSSUFsaU5VRTN2Y3ZleWlGT3AzSHpNZk5ka09TZFZRUHRsci9BVXJacmU0QTljSElnd0RydTQK"
    }
  }
}
